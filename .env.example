# cms-tenant-starter — environment variables
#
# Copy to .env.local for local dev, or set these in your Vercel project's
# Environment Variables (Project Settings → Environment Variables).
#
# All three are SERVER-SIDE — no NEXT_PUBLIC_ prefix. They never reach the
# browser bundle.

# ─── Where to fetch CMS data from ───────────────────────────────────────────
# Dev:  https://cms-api-dev.zwingd.com
# Prod: https://cms-api.zwingd.com  (not yet live as of 2026-05)
CMS_BASE=https://cms-api-dev.zwingd.com

# ─── Your tenant realm slug ─────────────────────────────────────────────────
# Scopes every CMS read to your tenant's data via the `realm` header +
# server-side RLS in cms-backend. The storefront fetches course landings from
# ${CMS_BASE}/api/v1/archetype-landings/${CMS_TENANT_REALM}/<code>.
# P4 reference demo: set CMS_TENANT_REALM=meridian and visit
# /courses/value-investing-101 to render the seeded "Meridian Institute" page.
CMS_TENANT_REALM=

# ─── Shared HMAC secret for /api/revalidate ────────────────────────────────
# Generate via the Zwingd CMS admin → Webhooks tab → click "Generate" next
# to the Secret field. Copy the value into here BEFORE saving the webhook
# (cms-backend hashes the secret on save; the response DTO omits the
# plaintext, so it's not retrievable from the API afterward).
CMS_WEBHOOK_SECRET=
